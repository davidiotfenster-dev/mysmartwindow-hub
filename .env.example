# ---------------------------------------------------------------------------
# Sitio  (IMPORTANTE en produccion)
# ---------------------------------------------------------------------------
# De aqui salen las URLs canonicas, el sitemap y las alternativas de idioma.
# OJO: las variables NEXT_PUBLIC_* se incrustan al COMPILAR, no se leen al
# arrancar. Cambiar el dominio obliga a recompilar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo si el sitio NO vive en la raiz del dominio.
# Ejemplo: /manuales  para  iotfenster.com/manuales
NEXT_PUBLIC_BASE_PATH=

# ---------------------------------------------------------------------------
# Google Analytics
# ---------------------------------------------------------------------------
# Vacio por defecto: sin esto el layout no monta GoogleAnalytics y no se
# envia nada a Google. Es NEXT_PUBLIC_, asi que se incrusta al COMPILAR igual
# que el resto de esta seccion -ponerlo despues no vale, hay que reconstruir
# la imagen (docker compose up -d --build).
#
# Se obtiene en analytics.google.com -> Administrar -> Flujos de datos ->
# el flujo web -> "ID de medicion" (formato G-XXXXXXXXXX).
#
# Solo se activa de verdad cuando quien visita acepta el aviso de cookies:
# arranca en modo "denegado" (Consent Mode) y CookieBanner lo pasa a
# "concedido" al aceptar. Coherente con lo que dice la politica de cookies.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# YouTube
# ---------------------------------------------------------------------------
# El sitio funciona SIN clave: usa el feed RSS publico del canal (ultimos 15
# videos). Si anades una clave de YouTube Data API v3 se activa automaticamente
# el catalogo completo del canal + las listas de reproduccion reales.
#
# Como obtenerla: console.cloud.google.com -> nuevo proyecto -> APIs y
# servicios -> habilitar "YouTube Data API v3" -> Credenciales -> Clave de API.
YOUTUBE_API_KEY=

# ID del canal MySmartWindow (no cambiar salvo que cambie el canal)
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=UCOYzORrjwX-krZhyK9-NqBQ
NEXT_PUBLIC_YOUTUBE_HANDLE=MySmartWindow

# Protege POST /api/youtube (resincronizacion manual y webhook)
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# CMS (Strapi)
# ---------------------------------------------------------------------------
# Sin STRAPI_URL, el sitio usa los ficheros de src/data/ (el catalogo de
# partida). Con Strapi arrancado y esta URL puesta, cada get*() de
# src/lib/content/ lee el CMS y cae de vuelta a src/data/ si no responde.
# OJO: NO lleva NEXT_PUBLIC_ -las paginas piden el contenido en el servidor,
# nunca desde el navegador-, asi que se puede cambiar sin recompilar.
STRAPI_URL=http://localhost:1337

# Solo necesario para leer contenido en borrador o escribir desde scripts
# (el seed, por ejemplo). La lectura publica normal no lo necesita: el
# bootstrap de Strapi activa find/findOne para el rol Public.
STRAPI_API_TOKEN=
