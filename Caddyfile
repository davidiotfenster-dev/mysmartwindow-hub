# Recepcionista del sitio: recibe en el 80 y el 443, sirve el HTTPS y pasa la
# peticion al contenedor `web`, que escucha en el 3000 dentro de la red de
# Docker y no esta publicado hacia fuera.
#
# El certificado lo pide y lo renueva Caddy solo, contra Let's Encrypt. No hay
# que instalar nada mas ni programar ninguna tarea: mientras el dominio apunte
# a esta maquina y los puertos 80 y 443 esten abiertos, se encarga el.

www.iotfenster.com, iotfenster.com {
	encode zstd gzip

	# ---------------------------------------------------------------------
	# PDF del WordPress anterior
	#
	# Los manuales se enlazaban como /wp-content/uploads/AAAA/MM/<fichero>.pdf
	# y esas direcciones siguen circulando: Google, ChatGPT, marcadores,
	# correos, codigos QR... Cada una va a la ficha de su recurso, que muestra
	# el PDF en pantalla con el boton de descarga.
	#
	# A la ficha y no al PDF del CMS a proposito: el fichero subido lleva un
	# codigo en el nombre que cambia cada vez que se sustituye el manual
	# (scripts/subir-pdfs.mjs ademas borra el anterior), y una redireccion
	# permanente a esa direccion se romperia con la primera actualizacion.
	#
	# Se reconoce por el nombre del fichero, sin mirar la carpeta del mes ni
	# los sufijos que WordPress anadia al resubir (-1, -2, _compressed): asi
	# tambien llegan las versiones antiguas de cada manual, que las hay
	# (p. ej. 2025/10/Instalacion-C-PULSAR-MySmartWindow.pdf).
	#
	# Gana la primera linea que encaja. Un PDF viejo que no sea de ningun
	# recurso va al centro de recursos en vez de dar un error.
	# ---------------------------------------------------------------------
	map {http.request.uri.path.file.base} {pdf_wordpress} {
		~(?i)^Perfiles_de_usuario-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/perfiles-de-usuario-manual
		~(?i)^Preguntas-frecuentes-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/preguntas-frecuentes-manual
		~(?i)^Perfiles_de_usuario_tarjeta(-[0-9]+|_compressed)*$ /es/recursos/perfiles-de-usuario-tarjeta
		~(?i)^Pregunta-frecuentes-dispositivo-MSW(-[0-9]+|_compressed)*$ /es/recursos/preguntas-frecuentes-dispositivo-tarjeta
		~(?i)^Pregunta-frecuentes-conectividad-y-vinculacion-MSW(-[0-9]+|_compressed)*$ /es/recursos/preguntas-frecuentes-conectividad-y-vinculacion-tarjeta
		~(?i)^Preguntas-frecuentes-tipos-de-motor(-[0-9]+|_compressed)*$ /es/recursos/preguntas-frecuentes-tipos-de-motor-tarjeta
		~(?i)^Conectividad_Como-ampliar-mi-cobertura_Documentacion-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/como-ampliar-mi-cobertura-manual
		~(?i)^ES_-Conectividad_Multiwifi_Documentacion-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/multiwifi-wifi-complementario-manual
		~(?i)^Manual_Android_WiFi_IoT_FENSTER_MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/compartir-una-red-wi-fi-desde-android-manual
		~(?i)^Dispositivo_botones_-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/hard-reset-botones-del-dispositivo-manual
		~(?i)^Reset_Software_-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/reset-software-manual
		~(?i)^C-PULSAR_Documentacion_MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/c-pulsar-documentacion-de-funcionalidades-manual
		~(?i)^C-Wall_Documentacion_MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/c-wall-documentacion-de-funcionalidades-manual
		~(?i)^Connect-1_Documentacion_MySmartWindow_v2(-[0-9]+|_compressed)*$ /es/recursos/connect-1-documentacion-de-funcionalidades-manual
		~(?i)^Connect-2_Documentacion_MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/connect-2-documentacion-de-funcionalidades-manual
		~(?i)^Connect_EVO_Documentacion(-[0-9]+|_compressed)*$ /es/recursos/connect-evo-documentacion-de-funcionalidades-manual
		~(?i)^RemoteWiTooth_Documentacion_MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/remotewitooth-documentacion-de-funcionalidades-manual
		~(?i)^Hard_reset_connect1-Dispositivos(-[0-9]+|_compressed)*$ /es/recursos/hard-reset-del-dispositivo-botones-tarjeta
		~(?i)^Manual-Alexa-Vinculacion-con-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/alexa-vinculacion-con-mysmartwindow-manual
		~(?i)^Manual-Alexa-Tarea-Programada-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/alexa-subir-la-persiana-a-una-hora-de-la-manana-manual
		~(?i)^.*Bajar_persianas_al_anochecer_Tarea-Programada-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/google-home-bajar-las-persianas-al-anochecer-manual
		~(?i)^.*Manual-Google-Home-Tarea-Programada-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/google-home-subir-las-persianas-a-las-8-00-manual
		~(?i)^Manual-Integracion-IFTTT-Tarea-Programada-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/ifttt-integracion-y-tareas-programadas-manual
		~(?i)^.*Que-es-IFTTT-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/que-es-ifttt-manual
		~(?i)^Aidoo_skills_ES(-[0-9]+|_compressed)*$ /es/recursos/aidoo-skills-manual
		~(?i)^Instalacion-Connect-1-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/connect-1-como-se-instala-el-dispositivo-manual
		~(?i)^Instalacion-Connect-2-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/connect-2-como-se-instala-el-dispositivo-manual
		~(?i)^Indicador-del-sensor-de-apertura-Instalacion(-[0-9]+|_compressed)*$ /es/recursos/instalacion-del-sensor-de-apertura-manual
		~(?i)^Instalacion-C-PULSAR-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/c-pulsar-instalacion-del-dispositivo-manual
		~(?i)^Manual-fabricacion-Cajon-RTX-La-VIUDA(-[0-9]+|_compressed)*$ /es/recursos/fabricacion-del-cajon-rtx-manual
		~(?i)^Instrucciones-CWALL(-[0-9]+|_compressed)*$ /es/recursos/c-wall-instalacion-del-dispositivo-manual
		~(?i)^Instalacion-EVO-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/connect-evo-instalacion-del-dispositivo-manual
		~(?i)^Manual-Vinculacion-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/vinculacion-punto-a-punto-manual
		~(?i)^Manual-de-Multivinculacion-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/multivinculacion-manual
		~(?i)^Manual-de-Multivinculacion_C-Wall-MySmartWindow(-[0-9]+|_compressed)*$ /es/recursos/c-wall-multivinculacion-manual
		~(?i)^Vinculacion-punto-a-punto_tarjeta(-[0-9]+|_compressed)*$ /es/recursos/vinculacion-punto-a-punto-tarjeta
		~(?i)^Vinculacion-c-wall(-[0-9]+|_compressed)*$ /es/recursos/vinculacion-c-wall-tarjeta
		~(?i)^Vinculacion-Multivinculacion(-[0-9]+|_compressed)*$ /es/recursos/multivinculacion-tarjeta
		default /es/recursos
	}
	@pdfWordpress path_regexp (?i)^/wp-content/uploads/.+\.pdf$
	redir @pdfWordpress {pdf_wordpress} permanent

	# ---------------------------------------------------------------------
	# Direcciones del WordPress anterior
	#
	# Al sustituir aquella web, sus direcciones dejan de existir. Sin estas
	# lineas, todo el que llegue desde Google o desde un enlace guardado se
	# encuentra un error, y se pierde el posicionamiento que tuvieran.
	# `permanent` es un 301: le dice al buscador que la pagina se ha mudado
	# para siempre y que traslade a la nueva lo que tenia la vieja.
	# ---------------------------------------------------------------------

	# Fichas de producto
	@connect2 path /connect-2 /connect-2/ /en/connect-2 /en/connect-2/
	redir @connect2 /es/dispositivos/connect-2 permanent

	@connect1 path /connect-1 /connect-1/ /en/connect-1 /en/connect-1/
	redir @connect1 /es/dispositivos/connect-1 permanent

	@cevo path /c-evo-interruptor-de-persiana-con-wifi /c-evo-interruptor-de-persiana-con-wifi/
	redir @cevo /es/dispositivos/connect-evo permanent

	@cpulsar path /c-pulsar-para-aluminio /c-pulsar-para-aluminio/
	redir @cpulsar /es/dispositivos/c-pulsar permanent

	@cwall path /c-wall /c-wall/
	redir @cwall /es/dispositivos/c-wall permanent

	@cwallsky path /c-wall-sky /c-wall-sky/
	redir @cwallsky /es/dispositivos/c-wall-sky permanent

	@cwallshutter path /c-wall-shutter /c-wall-shutter/
	redir @cwallshutter /es/dispositivos/c-wall-shutter permanent

	# El sensor RC-33 ya no esta en el catalogo: al escaparate, que es lo mas
	# util que le podemos ofrecer a quien buscaba ese producto.
	@sensor path /sensor-magnetico-rc-33 /sensor-magnetico-rc-33/
	redir @sensor /es/dispositivos permanent

	# Los dos servicios del Connect-2 se cuentan ahora en su propia ficha
	@servicios path /servicio-de-alertas-de-connect-2 /servicio-de-alertas-de-connect-2/ /servicio-offline-del-connect-2 /servicio-offline-del-connect-2/
	redir @servicios /es/dispositivos/connect-2 permanent

	# Paginas de empresa
	@equipo path /equipo /equipo/
	redir @equipo /es/ingenieria/equipo permanent

	@consultoria path /consultoria-de-innovacion-en-iot /consultoria-de-innovacion-en-iot/
	redir @consultoria /es/ingenieria/consultoria permanent

	@domotica path /domotica-para-cerramientos /domotica-para-cerramientos/
	redir @domotica /es/domotica-para-cerramientos permanent

	# Resto del sitio anterior
	@manuales path /app-mysmartwindow /app-mysmartwindow/
	redir @manuales /es/recursos permanent

	@blog path /blog /blog/
	redir @blog /es/noticias permanent

	# El area de cliente vivia en el WordPress y no tiene equivalente: a
	# soporte, que es donde se resuelve lo que la gente venia a buscar.
	@areacliente path /area-cliente /area-cliente/
	redir @areacliente /es/soporte permanent

	@contacto path /contacto /contacto/
	redir @contacto /es/contacto permanent

	@avisolegal path /aviso-legal /aviso-legal/
	redir @avisolegal /es/legal/aviso-legal permanent

	@privacidad path /politica-de-privacidad /politica-de-privacidad/
	redir @privacidad /es/legal/politica-de-privacidad permanent

	# ---------------------------------------------------------------------
	# Italiano
	#
	# No era una traduccion del plugin, sino paginas aparte con nombres
	# propios. Por eso van una a una y no siguen el patron de las espanolas.
	# ---------------------------------------------------------------------
	@itConsulting path /it/consulting /it/consulting/
	redir @itConsulting /it/ingenieria/consultoria permanent

	@itDomotica path /it/domotica-per-serramenti /it/domotica-per-serramenti/
	redir @itDomotica /it/domotica-para-cerramientos permanent

	@itConnect1 path /it/connect1 /it/connect1/
	redir @itConnect1 /it/dispositivos/connect-1 permanent

	@itConnect2 path /it/connect2 /it/connect2/
	redir @itConnect2 /it/dispositivos/connect-2 permanent

	@itCwall path /it/cwall /it/cwall/
	redir @itCwall /it/dispositivos/c-wall permanent

	@itManuali path /it/manuali /it/manuali/
	redir @itManuali /it/recursos permanent

	@itContatto path /it/contatto /it/contatto/
	redir @itContatto /it/contacto permanent

	# Todo lo demas, al sitio
	reverse_proxy web:3000
}

# ---------------------------------------------------------------------------
# Panel de contenidos
#
# El contenedor del CMS no esta publicado hacia fuera: Caddy le habla por la
# red interna de Docker. Lo unico que queda expuesto es lo que pasa por aqui,
# y siempre cifrado.
#
# Ojo con lo que esto significa: la pantalla de acceso al panel es visible
# desde internet, y detras de ella esta todo el contenido del sitio. Conviene
# contrasena larga y activar el doble factor, que Strapi trae de serie en
# Ajustes -> Perfil.
# ---------------------------------------------------------------------------
cms.iotfenster.com {
	encode zstd gzip

	# Los manuales y las fotos pesan: sin subir el limite, Strapi rechaza los
	# ficheros grandes con un error que no dice por que.
	request_body {
		max_size 200MB
	}

	reverse_proxy cms:1337
}
