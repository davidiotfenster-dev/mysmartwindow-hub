{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Ajustes del sitio",
    "description": "Datos globales: contacto, redes y SEO por defecto."
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "siteName": {
      "type": "string",
      "default": "MySmartWindow",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "organizationDescription": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "salesEmail": {
      "type": "email",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "supportEmail": {
      "type": "email",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "contactPhone": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "whatsappNumber": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "salesWhatsappMessage": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "supportWhatsappMessage": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
